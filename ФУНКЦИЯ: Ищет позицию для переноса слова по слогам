' =============================================================================
' ФУНКЦИЯ: Ищет позицию для переноса слова по слогам
' =============================================================================
' Правило: перенос ставится ПЕРЕД гласной, при условии, что перед этой гласной
' стоит хотя бы одна согласная. Например: "Нижневолжскнефть" > "Нижневолжскн-ефть".
' Возвращает позицию последнего символа первой части (1-based).
' Если перенос невозможен — возвращает 0.
Private Function FindHyphenationPos(word As String, maxChars As Long) As Long
    Dim i As Long
    Dim bestPos As Long
    bestPos = 0
    
    ' Ограничиваем поиск: первая часть не должна превышать maxChars,
    ' и нельзя переносить последний символ слова (иначе останется одна буква).
    Dim limit As Long
    limit = maxChars
    If limit > Len(word) - 1 Then limit = Len(word) - 1
    
    ' Идём с конца допустимой зоны к началу — ищем САМУЮ ПРАВУЮ позицию,
    ' чтобы первая часть была максимально длинной (но ? maxChars).
    For i = limit To 2 Step -1
        If i < Len(word) Then
            ' Проверяем: символ на позиции i — гласная?
            If IsVowel(Mid(word, i, 1)) Then
                ' Проверяем: символ перед гласной (i-1) — согласная?
                If Not IsVowel(Mid(word, i - 1, 1)) Then
                    ' Первая часть заканчивается на i-1 (на согласной перед гласной).
                    bestPos = i - 1
                    Exit For
                End If
            End If
        End If
    Next i
    
    FindHyphenationPos = bestPos
End Function
