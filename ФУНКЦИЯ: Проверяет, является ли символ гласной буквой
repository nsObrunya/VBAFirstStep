' =============================================================================
' ФУНКЦИЯ: Проверяет, является ли символ гласной буквой
' =============================================================================
' Используется для поиска места переноса слова по слогам.
' Гласные: русские (а, е, ё, и, о, у, ы, э, ю, я) + латинские (a, e, i, o, u, y).
' Регистр не важен — в строке есть и заглавные, и строчные.
Private Function IsVowel(ch As String) As Boolean
    Dim vowels As String
    vowels = "аеёиоуыэюяАЕЁИОУЫЭЮЯaeiouyAEIOUY"
    ' InStr возвращает позицию символа в строке. Если > 0 — символ найден (гласная).
    IsVowel = (InStr(vowels, ch) > 0)
End Function
